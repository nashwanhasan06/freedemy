# Freedemy runs with ZERO configuration. The SQLite database (data/freedemy.db),
# the session secret (data/session.secret) and the schema are all created
# automatically on first run. Everything below is optional — copy this file to
# .env.local only if you want to tune something.
#
# Most users never touch this file: sign up, open Settings (gear icon) and paste
# your AI API key there instead. A per-user key saved in Settings always wins
# over the values here.

# ---------------------------------------------------------------------------
# AI provider (machine-wide default)
# ---------------------------------------------------------------------------
# Valid values: nim | openai | anthropic | deepseek | gemini | custom
# "custom" is the per-account Custom option from Settings; in .env.local it
# additionally needs AI_BASE_URL and AI_MODEL (there is no default for either).
AI_PROVIDER=nim

# Shared key for whichever provider is active above (any vendor's key).
AI_API_KEY=

# Legacy NIM-specific names — still honoured, and only ever used for NIM.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=

# Shared model / endpoint overrides for the active provider.
AI_MODEL=
AI_BASE_URL=

# Requests-per-minute window. Unset = the provider default: 40 for NIM,
# no window for OpenAI / Anthropic / DeepSeek / Gemini. Set a number to opt
# any provider into a window (e.g. a small shared key).
AI_RPM_LIMIT=

# ---------------------------------------------------------------------------
# Concurrency tuning (rarely changed)
# ---------------------------------------------------------------------------
# In-flight caps: interactive calls (tutor, grading) vs background generation,
# and the requests/minute kept free for interactive work during a build.
AI_CONCURRENCY=4
AI_BACKGROUND_CONCURRENCY=10
AI_INTERACTIVE_RESERVE=8

# ---------------------------------------------------------------------------
# yt-dlp (YouTube captions — what makes link-to-course work)
# ---------------------------------------------------------------------------
# Defaults to `yt-dlp` on PATH; setup.mjs installs it for you.
YTDLP_PATH=
# Optional, for stubborn networks only:
YTDLP_COOKIES=
YTDLP_PROXY=

# ---------------------------------------------------------------------------
# Storage / sessions (rarely needed)
# ---------------------------------------------------------------------------
# Defaults: data/freedemy.db, and an auto-generated data/session.secret.
# Point FREEDEMY_DB_PATH elsewhere to keep the database out of the repo.
FREEDEMY_DB_PATH=
# Only set this if you back up / restore the secret across machines.
FREEDEMY_SESSION_SECRET=
