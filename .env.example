# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it holds the service role key and the model key.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the course generator to write course content and usage logs.
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: absolute path to yt-dlp if it is not on PATH.
# YTDLP_PATH=C:\tools\yt-dlp.exe
# Optional: a Netscape-format cookies.txt exported from a browser where
# youtube.com works. Helps when YouTube rate-limits or bot-checks this IP.
# YTDLP_COOKIES=C:\tools\youtube-cookies.txt
# Optional: HTTP/SOCKS proxy for yt-dlp, the reliable fix for a rate-limited IP.
# YTDLP_PROXY=http://127.0.0.1:7890

# Request pacing. The scheduler never exceeds AI_RPM_LIMIT calls in any 60s window.
AI_RPM_LIMIT=40
# In-flight caps per lane: interactive (tutor, grading) vs background generation.
AI_CONCURRENCY=4
AI_BACKGROUND_CONCURRENCY=10
# Kept free for tutor messages and grading while a course is generating.
AI_INTERACTIVE_RESERVE=8

# Resend (transactional email — password reset links). Without a key the reset
# link is printed to the server log instead of being emailed.
RESEND_API_KEY=
# Must be a sender verified in Resend → Domains. Test mode only allows:
# EMAIL_FROM="Freedemy <onboarding@resend.dev>"
EMAIL_FROM="Freedemy <onboarding@resend.dev>"
